# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# ---- runtime output / artefacts ----
# keep the experiment results (small, authoritative), drop regenerable logs
polymarket_sniper/output/*
!polymarket_sniper/output/sweep_results.csv
!polymarket_sniper/output/sweep_ranking.json
!polymarket_sniper/output/manual_metrics.json
!polymarket_sniper/output/manual_trades.csv
*.log
.cache/
.work/
.tmp/
tmp/

# ---- market data dumps (large; regenerate with scripts/hf_fetch.py) ----
work/
*.part
wheels/
_wheels/
vendor/

# ---- high-frequency market data (supplied archives + extraction) ----
# tar.gz archives are ~1.26 GB; the extracted Hive tree is ~1.3 GB over 3,322
# files. Both are inputs, not source. Rebuild with:
#   python polymarket_v3/tools_v3/extract_archives_v3.py
market_parquet_*.tar.gz
micro_v3/
_staging/

# ---- 1-day order book export (superseded by the micro_v3 tree) ----
markets.parquet
snapshots.parquet
trades.parquet
deltas.parquet

# ---- regenerable run outputs (keep the code, drop the artefacts) ----
output/

# ---- credentials / local secrets ----
.github-auth.json
.github-ca-cache.pem
.env
.env.*
*.pem
*.key
credentials.json

# ---- editor / OS ----
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
