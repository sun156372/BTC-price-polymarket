{
  "_comment": "Values marked MEASURED come from backtests on this dataset. See README.md section 'Why these numbers'.",
  "data": {
    "data_dir": "../data",
    "assets": ["BTC", "ETH", "SOL", "XRP"],
    "batch_size": 100000,
    "require_spot": true
  },
  "signal": {
    "lookback_s": 180.0,
    "min_move_pct": 0.05,
    "entry_t_minus_s": 120.0,
    "one_entry_per_window": true,
    "max_spot_staleness_s": 30.0
  },
  "exits": {
    "take_profit": 0.30,
    "stop_loss": 0.20,
    "stop_loss_wins_ties": true,
    "hold_to_settlement": true
  },
  "guards": {
    "max_quote_staleness_s": 10.0,
    "max_slippage_bps": 200.0,
    "max_depth_participation": 0.5,
    "min_window_elapsed_s": 60.0
  },
  "fees": {
    "taker_coefficient": 0.07
  },
  "sizing": {
    "notional_usdc": 100.0,
    "max_position_pct_equity": 1.0,
    "starting_equity": 10000.0
  },
  "backtest": {
    "trades_file": "auto",
    "assets_filter": [],
    "max_markets": 0,
    "output_dir": "../output/engine",
    "simulate_adverse_fills": true,
    "entry_slippage_bps": 50.0,
    "exit_slippage_bps": 50.0
  },
  "logging": {
    "level": "INFO"
  }
}
